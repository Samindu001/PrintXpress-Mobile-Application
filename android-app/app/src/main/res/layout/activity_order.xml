<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#1746A2"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvOrderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Printing Order"
            android:textColor="#172033"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Customise your printing order."
            android:textColor="#687386"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvSizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Size"
            android:textColor="#172033"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spSize"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <TextView
            android:id="@+id/tvPaperLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Material / Print Option"
            android:textColor="#172033"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spPaper"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Quantity"
            android:textColor="#172033"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spQuantity"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Design File"
            android:textColor="#172033"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnUpload"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Choose Design (PDF / PNG / JPG)"
            android:textAllCaps="false"
            android:backgroundTint="#E0E9FA"
            android:textColor="#1746A2" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No file selected"
            android:textColor="#687386"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Delivery Method"
            android:textColor="#172033"
            android:textStyle="bold"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/rgDelivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delivery" />

            <RadioButton
                android:id="@+id/rbPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pickup" />

        </RadioGroup>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Delivery address"
            android:inputType="textPostalAddress"
            android:minHeight="56dp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Estimated Total: LKR 0.00"
            android:textColor="#1746A2"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="Confirm Order"
            android:textAllCaps="false"
            android:backgroundTint="#1746A2"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>